# PeerPool Smart Contract Environment
# Copy this to .env and fill in your values

# Deployment
PRIVATE_KEY=0x...                    # Deployer private key
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETHERSCAN_API_KEY=...

# Protocol Configuration
FEE_RECIPIENT=0x...                  # Address receiving protocol fees
PROTOCOL_FEE_BPS=50                  # 0.5% protocol fee
BOND_SLASH_BPS=2000                  # 20% bond slash on invalid dispute

# External Integrations
KLEROS_ARBITRATOR=0x988b3A538b618C7a603e1c11Ab82Cd16dbE28069  # Kleros Court v1 (Ethereum mainnet)

# Deployed Addresses (filled after deployment)
MANIFEST_REGISTRY=
ESCROW_CONTRACT=
DISPUTE_CONTROLLER=
SETTLEMENT_ENGINE=
MERKLE_DISTRIBUTOR=
ATTESTATION_VERIFIER=
FEE_CONTROLLER=
BOND_MANAGER=

# Testnet (Sepolia)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_PRIVATE_KEY=0x...

# Local Development
ANVIL_RPC_URL=http://localhost:8545
ANVIL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
