{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.2",
  "license": "MIT",
  "scripts": {
    "preinstall": "node ./scripts/check-package-manager.mjs",
    "build": "corepack pnpm run typecheck && corepack pnpm -r --if-present run build",
    "db:push:local": "corepack pnpm --filter @workspace/scripts run db:push:local",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "smoke:prod": "corepack pnpm --filter @workspace/scripts run smoke:prod",
    "smoke:prod:db": "corepack pnpm --filter @workspace/scripts run smoke:prod:db",
    "typecheck:libs": "tsc --build",
    "typecheck": "corepack pnpm run typecheck:libs && corepack pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
