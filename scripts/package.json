{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:push:local": "tsx ./src/db-push-local.ts",
    "hello": "tsx ./src/hello.ts",
    "smoke:prod": "tsx ./src/smoke-prod.ts",
    "smoke:prod:db": "tsx ./src/smoke-prod-db.ts",
    "test:adhoc:phase2": "tsx ./src/adhoc/phase2-data-mutation.ts",
    "test:adhoc:phase3": "tsx ./src/adhoc/phase3-concurrency-abuse.ts",
    "test:adhoc:phase4": "tsx ./src/adhoc/phase4-persona-derailment.ts",
    "test:whitebox:phase1": "tsx ./src/whitebox/phase1-structure-map.ts",
    "test:whitebox:phase2": "node --test --test-force-exit --import tsx ./src/tests/whitebox/phase2-*.test.ts",
    "test:whitebox:phase3": "node --test --test-force-exit --import tsx ./src/tests/whitebox/phase3-*.test.ts",
    "test:whitebox:phase4": "node --test --test-force-exit --import tsx ./src/tests/whitebox/phase4-*.test.ts",
    "test:whitebox:coverage": "node --test --experimental-test-coverage --import tsx ./src/tests/whitebox/**/*.test.ts",
    "test:e2e": "tsx --test ./src/tests/e2e/**/*.test.ts",
    "test:integration": "tsx --test ./src/tests/integration/**/*.test.ts",
    "test:unit": "tsx --test ./src/tests/unit/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "viem": "^2.31.0"
  }
}
